# Backend environment template — copy to backend/.env and fill in real values.
# NEVER commit backend/.env (it is gitignored). Leave placeholders blank here.
# Keys mirror backend/app/core/config.py (pydantic-settings, case-insensitive).

# development | production
APP_ENV=development

# Postgres connection string (psycopg v3), e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# OpenWeather API key
OPENWEATHER_API_KEY=

# Seconds to cache a weather response
WEATHER_CACHE_TTL_SECONDS=1800

# Comma-separated allowed browser origins for CORS.
# Origins are matched exactly: scheme + host + port. Note that
# http://localhost:5173 and http://127.0.0.1:5173 are DIFFERENT origins, and
# Vite silently falls back to 5174/5175 when its configured port is taken —
# a mismatch here shows up in the browser as "Failed to fetch".
# For local dev, list every port/host pair you actually use, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Demo / offline behaviour flags
DEMO_MODE=true
USE_CACHED_WEATHER=false
