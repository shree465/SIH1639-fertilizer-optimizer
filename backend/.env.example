# Backend environment template — copy to backend/.env and fill in real values.
# NEVER commit backend/.env (it is gitignored). Leave placeholders blank here.
# Keys mirror backend/app/core/config.py (pydantic-settings, case-insensitive).

# development | production
APP_ENV=development

# Postgres connection string (psycopg v3), e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# OpenWeather API key
OPENWEATHER_API_KEY=

# Seconds to cache a weather response
WEATHER_CACHE_TTL_SECONDS=1800

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Demo / offline behaviour flags
DEMO_MODE=true
USE_CACHED_WEATHER=false
